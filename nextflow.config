/*
 * hmmsearch_kofam pipeline configuration
 *
 * Check the setup, on anything, in about 30 seconds:
 *   nextflow run main.nf -profile test,docker
 *
 * Laptop or workstation, tools supplied by Docker:
 *   nextflow run main.nf --genomes 'genomes/*.fna' --hmms profiles.hmm -profile laptop,docker
 *
 * University of Arizona HPC:
 *   nextflow run main.nf ... -profile uahpc,singularity
 *
 * Any other Slurm cluster, once you have filled in an account and a partition:
 *   cp conf/site_template.config conf/mysite.config
 *   nextflow run main.nf ... -profile slurm,singularity -c conf/mysite.config
 */

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------

params {
    input          = null
    genomes        = null
    proteins       = null
    hmms           = null
    extra_hmms     = null
    hmm_chunk_size = null
    hmm_chunks     = null
    max_concurrent       = null
    subsample_genomes    = 0
    subsample_hmms       = 0
    outdir               = 'results'
    no_masking           = false
    busco_lineage        = null
    busco_downloads      = null
    sigma                = null
    taxonomy             = null
    domtblout            = null
    completeness         = null
    id_from_filename     = false
    no_blimmp_log        = false

    // Described in nextflow_schema.json along with everything above, which is
    // what --help prints and what the unknown-parameter check validates against.
    help                 = false
    help_all             = false
    validate_params      = true
}

// ---------------------------------------------------------------------------
// Process resource defaults
// ---------------------------------------------------------------------------

process {
    // Retry only what a retry can fix. A tool that rejects its input exits with
    // its own status and will do so again on the second attempt, so retrying it
    // costs two scheduler round trips and buries the message under NOTE lines.
    // Exit codes 130 to 145 are the ones a signal produces: 137 is the
    // out-of-memory kill and 143 the walltime kill, and both are about the
    // allocation rather than the data. 104 is what a task killed before its
    // command started reports.
    //
    // `finish` rather than `terminate` for everything else, so tasks already
    // running are allowed to end and their results stay in the cache.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    // Resources grow with the attempt, so a task killed for exceeding its
    // allocation gets a larger one instead of failing the same way twice.
    // Memory scales in each execution profile below, where it is set.
    withLabel: 'process_low' {
        cpus = 1
        time = { 1.h * task.attempt }
    }

    withLabel: 'process_medium' {
        cpus = 4
        time = { 8.h * task.attempt }
    }

    // hmmsearch speeds up little past --cpu 2. It parallelises
    // over the target sequence database, and the target here is one genome's
    // proteins, a few thousand sequences. Measured on Stampede3, one chunk of
    // 1159 KOfam profiles against 2565 proteins, alone on a 48-core node:
    //
    //     --cpu 1   46.4s        --cpu 8    28.2s
    //     --cpu 2   32.0s        --cpu 16   29.0s
    //     --cpu 4   27.7s
    //
    // Total CPU stays near 49s at every setting, so the extra threads are not
    // doing extra work. The speedup saturates at 1.67x and then reverses. Four
    // cores give 1.67x at 42% efficiency; two give 1.45x at 72%, and the two
    // cores left free run another chunk.
    //
    // Set by name rather than by label because RUN_BUSCO and RUN_BLIMMP share
    // the process_medium label and the timing covered only hmmsearch. A target
    // database much larger than one bacterial proteome may scale further.
    withName: 'HMMSEARCH' { cpus = 2 }
}

// ---------------------------------------------------------------------------
// Execution profiles
// ---------------------------------------------------------------------------

// Profiles come in two kinds and a run normally names one of each:
//
//     -profile <where it runs>,<how the tools are provided>
//
// for example `-profile laptop,docker` or `-profile uahpc,singularity`. Each
// profile stands on its own, so nothing here needs a -c file. Supply one only
// for a cluster this file does not already know about, starting from
// conf/site_template.config.

profiles {

    // -- Where the work runs ------------------------------------------------
    // Each of these sets the executor. The local ones also set memory, which on
    // a local executor is a plain ceiling; on Slurm it is a scheduler flag whose
    // spelling varies by site, so `slurm` leaves it to the site config.
    // cpus and time come from the base process block above.

    standard {
        // Nextflow's default when no profile is named.
        process.executor = 'local'
        process {
            withLabel: 'process_low'    { memory = { 4.GB  * task.attempt } }
            withLabel: 'process_medium' { memory = { 16.GB * task.attempt } }
        }
    }

    laptop {
        process.executor = 'local'
        process {
            withLabel: 'process_low'    { memory = { 4.GB * task.attempt } }
            withLabel: 'process_medium' { memory = { 8.GB * task.attempt } }
        }
    }

    server {
        process.executor = 'local'
        process {
            withLabel: 'process_low'    { memory = { 8.GB * task.attempt } }
            withLabel: 'process_medium' { cpus = 16; memory = { 32.GB * task.attempt } }
        }
    }

    slurm {
        // A cluster this file does not know the account and partition for.
        // Add them with -c your_site.config; conf/site_template.config is a
        // starting point. Values in a -c file are applied after this profile,
        // so they win.
        //
        // No memory here, deliberately, matching the base process block. Memory
        // is the one resource whose spelling is cluster-specific: some Slurm
        // sites honour --mem and others only --mem-per-cpu, and sbatch rejects
        // the two together. Setting it per label here would also be unclearable,
        // because a withLabel value outranks the `memory = null` a site config
        // sets at the process level. So the site config owns memory outright.
        process.executor = 'slurm'
    }

    uahpc {
        // University of Arizona HPC (Puma / El Gato).
        process.executor = 'slurm'
        process {
            // Slurm here ignores #SBATCH --mem and silently allocates 1 MB, so
            // memory has to arrive as --mem-per-cpu. Nextflow renders its own
            // `memory` directive as --mem, and sbatch rejects the two together,
            // which is why memory is cleared rather than set.
            //
            // The cost is that memory cannot grow on a retry here: a
            // clusterOptions string is fixed text and cannot see task.attempt.
            // Time still scales, so a walltime kill retries usefully and an
            // out-of-memory kill does not.
            memory         = null
            queue          = 'standard'
            clusterOptions = '--account=twheeler --mem-per-cpu=4G'
        }
    }

    // -- How the tools are provided ----------------------------------------
    // HMMER, pyrodigal, BUSCO and BLIMMP have to come from somewhere. Name one
    // of these, or leave them out if the tools are already on PATH.

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true

        // --cleanenv drops the thread guards a site sets for the job, and
        // OpenBLAS sizes its pool from the machine's core count when none is
        // set. On a cluster that hands a job a whole node that is the node's
        // count: nine concurrent BUSCO tasks on a 48-core Stampede3 node each
        // went for 48 OpenBLAS threads, failed to allocate, and parked in
        // futex_wait_queue rather than exiting. Nine of nine hung, 76 "OpenBLAS
        // error: Memory allocation still failed after 10 retries", on a node
        // sitting at load 0.31. One BUSCO alone is fine either way, which is
        // what makes it easy to miss. Measured: 0/9 complete without this,
        // 9/9 in about 20 seconds with it.
        //
        // On the runOptions line rather than as APPTAINERENV_/SINGULARITYENV_
        // variables in the `env` scope. Nextflow launches the container with
        //
        //     env - PATH="$PATH" ... singularity exec ... --cleanenv ...
        //
        // and `env -` scrubs the environment before singularity reads it, so
        // those variables show up in `nextflow config` output and never reach
        // the launcher. Ordinary exports from the `env` scope are a different
        // path (nxf_container_env, evaluated inside the container) and were not
        // tried; --env keeps the limit next to the --cleanenv that discards it.
        //
        // One thread because BUSCO parallelises itself with -c ${task.cpus},
        // so OpenBLAS threads on top of that are oversubscription.
        // Singularity passes the host environment into the container by default,
        // so host variables can change how the containerised tools behave. A
        // PYTHONPATH pointing at a local BLIMMP checkout, for instance, would
        // shadow the version installed in the image. Start from a clean slate.
        singularity.runOptions = '--cleanenv --env OPENBLAS_NUM_THREADS=1,OMP_NUM_THREADS=1'
        // Set NXF_SINGULARITY_CACHEDIR in your environment (or site config)
        // to reuse pulled images across runs, e.g.:
        //   export NXF_SINGULARITY_CACHEDIR=/xdisk/$USER/singularity_cache
    }

    modules {
        // Environment modules instead of containers. The module name and
        // version is the one on UA HPC; on another cluster run
        // `module avail hmmer` and override this with -c.
        // Only hmmsearch has a module here. pyrodigal, tantan, BUSCO and BLIMMP
        // do not, so this profile needs those on PATH already. pyrodigal and
        // tantan are the two a run always reaches: `pip install pyrodigal` and a
        // tantan build, or --no_masking to skip the second. The preflight check
        // in main.nf names whatever is missing before submitting anything.
        //
        // Prodigal 2.6.3 had a module and pyrodigal does not, which is a real
        // cost of the switch. It buys byte-identical output from maintained
        // code: verified on the bundled MED4 slice, 158 sequences, same md5.
        process.beforeScript = 'source /etc/profile.d/lmod.sh; module load hmmer/3.4'
    }

    // -- The bundled dataset ------------------------------------------------

    test {
        // Small enough to finish in about 30 seconds. Name a tool profile
        // alongside it: -profile test,docker
        includeConfig 'conf/test.config'
    }
}

// ---------------------------------------------------------------------------
// Concurrency cap
// ---------------------------------------------------------------------------

// Written as an expression rather than an `if`, because the strict config parser
// that Nextflow 26.04 turns on by default rejects if statements in config files.
//
// 100 is Nextflow's own default for grid executors, so leaving --max_concurrent
// unset behaves as it did when this was a conditional block. The local executor
// throttles on available CPUs and memory as well, so the cap is not the binding
// constraint there.
executor {
    queueSize = params.max_concurrent ?: 100
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

// ---------------------------------------------------------------------------
// Pipeline identity
// ---------------------------------------------------------------------------

manifest {
    name          = 'BLIMMP-MHPP-NF'
    author        = 'Neha Sontakke'
    homePage      = 'https://github.com/NehaSontakk/BLIMMP-MHPP-NF'
    description   = 'Fork of blimmp-nf (Travis Wheeler) wired to BLIMMP_MHPP, the K99001/MHPP001 module addition to BLIMMP. Bacterial genomes to KEGG module presence: pyrodigal gene calling, HMMER search against KOfam, and BLIMMP module inference.'
    mainScript    = 'main.nf'
    defaultBranch = 'main'
    version       = '0.1.0-mhpp1'

    // The leading `!` makes this a hard stop. Without it Nextflow prints
    // "Execution will continue, but things may break!" and runs anyway, which
    // on an older release means a parse error partway through main.nf instead
    // of a message naming the version it wants. CI runs 22.10.7, 24.04.4,
    // 25.10.4 and 26.04.0, so the floor is checked rather than assumed.
    nextflowVersion = '!>=22.10.0'
}
