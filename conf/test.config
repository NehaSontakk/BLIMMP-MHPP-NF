/*
 * Bundled test dataset.
 *
 *   nextflow run main.nf -profile test,docker
 *   nextflow run main.nf -profile test,singularity
 *
 * Runs the whole pipeline, gene calling through module inference, on data small
 * enough to finish in a couple of minutes on one machine. It answers whether
 * your setup works. It says nothing about your own genomes: two 150 kb slices
 * of real Prochlorococcus genomes searched against 20 KOfam profiles out of
 * 27,262.
 *
 * How the data was chosen is in assets/test/README.md.
 *
 * --sigma, because BUSCO downloads a lineage on first use, which turns a
 * two-minute check of your setup into a slow one that fails without network.
 * The value is a stand-in: a 150 kb slice of a genome is not 95% of anything.
 */

params {
    // A glob. A bare directory is read as a flat one, and this data is laid out
    // one genome per subdirectory so the sample IDs come out as MED4 and
    // MIT9301. Pointed at the directory, nothing matches and the run stops.
    genomes        = "${projectDir}/assets/test/genomes/*/*.fna"
    hmms           = "${projectDir}/assets/test/kofam"
    sigma          = 0.95
    outdir         = 'results_test'
    // No hmm_chunk_size here on purpose. Left unset, this profile exercises the
    // automatic chunk sizing, which is what a real run without the flag does.
    // CI runs it a second time with --hmm_chunk_size 5 for the several-chunks
    // path, since 20 profiles on a small runner otherwise come out as one.
}

process {
    // Small enough to run anywhere, including a laptop or a CI runner.
    //
    // No `memory` here, deliberately, matching the base config. Memory is the
    // one resource whose spelling is cluster-specific: a site config may express
    // it as `--mem` or as `--mem-per-cpu` in clusterOptions, and sbatch rejects
    // both together. Setting it here made `-profile test,slurm -c yoursite.config`
    // fail with "--mem, --mem-per-cpu, and --mem-per-gpu are mutually exclusive".
    //
    // Set directly rather than through `resourceLimits`, which needs Nextflow
    // 23.10 while this pipeline supports 22.10.
    withLabel: 'process_low'    { cpus = 1; time = '30 m' }
    withLabel: 'process_medium' { cpus = 2; time = '30 m' }
}
