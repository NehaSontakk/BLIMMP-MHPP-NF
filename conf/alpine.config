/*
 * CU Boulder Alpine, reached through RMACC. See docs/hpc.md for the full
 * comparison against UA HPC.
 *
 * The account below is the one an RMACC user gets; a CU Boulder user's looks
 * like ucb###_asc1 instead. `sacctmgr show assoc user=$USER` prints yours.
 *
 * Alpine honours plain --mem, unlike UA HPC, so memory is set directly per
 * label as a retry-scaling closure rather than folded into clusterOptions.
 *
 * cpu-normal, not cpu-long, is the default QoS here: Alpine rejects a
 * cpu-long submission outright unless its requested walltime is over 24
 * hours ("Error 19"), and process_low/process_medium ask for 1h/8h by
 * default (nextflow.config), both well under that floor. cpu-normal's own
 * 24h cap still covers every retry at those defaults (maxRetries = 2, so
 * process_medium tops out at 8h * 3 = 24h). A step that genuinely needs
 * longer than a day should set qos=cpu-long on its own clusterOptions, not
 * carry it as the default for everything.
 */
process {
    queue          = 'acpu'
    clusterOptions = '--account=rmacc-general --qos=cpu-normal'

    withLabel: 'process_low'    { memory = { 4.GB  * task.attempt } }
    withLabel: 'process_medium' { memory = { 16.GB * task.attempt } }
}
