/*
 * Template for a machine this pipeline has no profile for.
 *
 * Most setups need nothing in this directory. Check the profiles in
 * nextflow.config first:
 *
 *     -profile laptop,docker           a laptop or workstation
 *     -profile server,docker           a large shared machine
 *     -profile uahpc,singularity       University of Arizona HPC
 *     -profile slurm,singularity       any other Slurm cluster, plus this file
 *
 * Only the last one needs you, because an account and a partition cannot be
 * guessed. Copy this file, fill those in, delete the rest, and name it:
 *
 *     cp conf/site_template.config conf/mysite.config
 *     nextflow run main.nf ... -profile slurm,singularity -c conf/mysite.config
 *
 * A -c file is applied after the profile, so anything set here wins.
 *
 * Expect to need this file. A Slurm cluster is not a standard: how memory must
 * be requested, what the partitions are called, whether a QoS is mandatory and
 * how containers are provided all vary between sites, and a working script from
 * one cluster can fail on another for none of the reasons you would guess.
 *
 * First find out whether your cluster shares a node between jobs. If it does
 * not, this template does not apply: there is no memory or cpus to request, one
 * sbatch job per task bills a whole node per task, and the executor belongs
 * inside a single allocation instead. conf/stampede3.config is that shape and
 * looks nothing like this file.
 * docs/hpc.md sets two real clusters side by side and lists what differs, which
 * is a decent checklist of questions to put to your own documentation.
 */

process {
    // The partition to submit to: 'standard', 'normal', 'batch', whatever your
    // cluster calls it. `sinfo -s` lists them.
    queue = 'your_partition'

    // Anything else that has to reach sbatch. A shared cluster almost always
    // wants an account to bill.
    clusterOptions = '--account=your_account'

    // Memory, which -profile slurm deliberately leaves alone, because how a
    // cluster wants it asked for is the one thing that varies most.
    //
    // If yours honours --mem, which most do, set it per label and Nextflow
    // emits --mem for you:
    //
    //     withLabel: 'process_low'    { memory = { 4.GB  * task.attempt } }
    //     withLabel: 'process_medium' { memory = { 16.GB * task.attempt } }
    //
    // Written as a closure so a retry asks for more than the attempt that was
    // killed. A task killed for exceeding its memory is the main thing worth
    // retrying, and a fixed number retries into the same wall.
    //
    // If yours only honours --mem-per-cpu, leave `memory` unset and fold the
    // request into the clusterOptions line above:
    //
    //     clusterOptions = '--account=your_account --mem-per-cpu=4G'
    //
    // Setting both makes sbatch refuse the job outright: --mem and
    // --mem-per-cpu are mutually exclusive.
    //
    // To find out which yours honours:
    //     scontrol show config | grep -i -E 'DefMemPer|MaxMemPer'
    //
    // The uahpc profile in nextflow.config is a worked example of the
    // --mem-per-cpu case. Note what it costs: a clusterOptions string cannot
    // see task.attempt, so retries there get more time and the same memory.

    // Per-label overrides, if the defaults do not fit. process_low is one CPU
    // of bookkeeping; process_medium is hmmsearch and BUSCO.
    //
    //     withLabel: 'process_low'    { memory = { 4.GB * task.attempt } }
    //     withLabel: 'process_medium' { cpus = 8; memory = { 32.GB * task.attempt }; time = { 12.h * task.attempt } }
}

/*
 * Containers on a shared filesystem
 *
 * -profile singularity pulls each image on first use. Point
 * NXF_SINGULARITY_CACHEDIR at somewhere shared and persistent so that only
 * happens once, on scratch or project storage rather than in $HOME:
 *
 *     export NXF_SINGULARITY_CACHEDIR=/path/to/shared/singularity_cache
 *
 * Compute nodes without outbound network cannot pull. Run the bundled test
 * once from a node that can, which fills the cache:
 *
 *     nextflow run main.nf -profile test,singularity
 */

/*
 * Environment modules instead of containers
 *
 * -profile modules loads hmmer by the name UA HPC uses. If your cluster names
 * it differently, or has a pyrodigal module where UA HPC does not, override it
 * here:
 *
 *     process.beforeScript = 'module load pyrodigal/3.7 hmmer/3.4'
 *
 * Modules cover the HMMER half of the pipeline. BUSCO and BLIMMP still need
 * containers, so a module-only run is one that stops at the search results.
 */

/*
 * AWS Batch
 *
 * Never run, so treat this as a starting point rather than a recipe. Batch
 * needs the work directory on S3, given on the command line:
 *
 *     nextflow run main.nf ... -profile docker -c conf/mysite.config \
 *         -work-dir s3://your-bucket/work
 *
 *     process.executor  = 'awsbatch'
 *     process.queue     = 'your-job-queue'
 *     aws.region        = 'us-east-1'
 *     aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
 */
