/*
 * TACC Stampede3. See docs/hpc.md for the full comparison against UA HPC and
 * Alpine.
 *
 * This config is shaped differently from conf/alpine.config, and the reason is
 * one line in TACC's own documentation:
 *
 *     "TACC does not implement node-sharing on any compute resource. Each
 *      Stampede3 compute node can be assigned to only one user at a time."
 *
 * Slurm is configured to match: SelectType=select/linear, OverSubscribe=NO,
 * DefMemPerNode=UNLIMITED. Every job gets a whole node and all of its memory.
 *
 * That breaks the usual Nextflow-on-Slurm arrangement, where each task is its
 * own sbatch job. On a per-core cluster a process_low task asks for one core
 * and is billed for one core. Here it is billed for 48. Stampede3 charges
 * 1 SU per skx node-hour, so with -profile slurm the SU bill is the sum of
 * every task's wall time, at 48x the CPU you asked for. For the nine-genome
 * known-answer run that is most of a small allocation spent on idle cores.
 *
 * So on Stampede3 the executor is local, inside one batch allocation, and the
 * node's 48 cores are the resource pool Nextflow schedules against. One node
 * for the length of the run, 1 SU per hour, whatever the task count. Submit it
 * with the sbatch script in docs/hpc.md, and note that it is
 *
 *     -profile singularity -c conf/stampede3.config
 *
 * with no `slurm`, unlike every other site config here.
 *
 * The multi-node version of this is Nextflow's slurm executor and it is the
 * right answer on a cluster that shares nodes. If you need more than one node
 * of throughput on Stampede3, run several genome subsets as separate batch
 * jobs rather than letting Nextflow submit per-task jobs.
 */

// Memory is deliberately absent from clusterOptions, and there is no --mem
// anywhere. Stampede3's sbatch documents --mem as "not available": the node is
// yours and so is its memory.
//
// --mem is not ignored either. Probed with `sbatch --test-only`, which spends
// no allocation:
//
//     -N 1                       -> 48 processors on one node
//     -N 1 --mem=8G              -> 48 processors on one node   (accepted, ignored)
//     -N 1 -c 4                  -> 48 processors on one node   (accepted, ignored)
//     -N 1 --mem=400G            -> "Requested node configuration is not available"
//     -N 1 --mem=8G --mem-per-cpu=4G -> fatal, mutually exclusive
//
// So --mem changes nothing about what you get, but is still validated against
// the node's RealMemory, and a request above it is rejected at submission. A
// site config that set `memory = 256.GB` for a large step would be refused on
// skx (191 GB) while doing nothing useful if it fit. UA HPC ignores --mem and
// allocates 1 MB; Alpine honours it; Stampede3 ignores it and range-checks it
// anyway.
//
// The `memory` values below are therefore not scheduler requests. On a local
// executor Nextflow uses them as a ceiling for deciding how many tasks fit at
// once, so they are what stops 48 cores' worth of hmmsearch from oversubscribing
// 191 GB. Written as closures so a retry gets more than the attempt that died.

executor {
    // Bound the pool to the node. 48 and not 46: the pipeline's own chunk
    // sizing reads Runtime.availableProcessors() rather than this value, so a
    // lower number here would leave the advertised slot count and the real one
    // disagreeing. The Nextflow JVM shares the node with the tasks, which costs
    // little because it is idle waiting on them.
    //
    // These are skx numbers. On spr it is 112 cores and 127 GB, on icx 80 and
    // 256 GB, and the memory ceiling starts to bind on spr: 28 concurrent
    // process_medium tasks at 8 GB would want 224 GB of a 127 GB node, so
    // Nextflow would run 15 and leave 52 cores idle. Lower the ceiling before
    // moving this to spr, or stay on skx, which is also the largest queue and
    // the cheapest per node-hour.
    cpus   = 48
    memory = 180.GB
}

process {
    executor = 'local'

    withLabel: 'process_low'    { memory = { 4.GB * task.attempt } }
    withLabel: 'process_medium' { memory = { 8.GB * task.attempt } }

    // HMMSEARCH's cpus is set in nextflow.config, by name, from a thread
    // scaling measurement taken here; see the comment there. Only its memory
    // ceiling is local to this file, because it exists to stop the local
    // executor packing more concurrent searches into the node than its RAM
    // holds, and a scheduler-driven site has no equivalent. A running task was
    // 45 MB resident, so 2 GB is loose.
    //
    // The nine-genome reference set on one skx node, --hmm_chunks 24:
    //
    //     cpus = 4    9m26s   2h40m CPU   16.3 of 48 cores busy
    //     cpus = 2    7m05s   2h41m CPU   22.6 of 48 cores busy
    //     cpus = 1    4m54s   2h49m CPU   34.6 of 48 cores busy
    //
    // All three reproduce docs/reference_summary.tsv exactly, so the thread
    // count does not move the answer. Two is the pipeline default, set in
    // nextflow.config, and it is the right default because it also suits a
    // cluster that bills by the core. Here the node is held either way, so to
    // finish sooner, override cpus to 1 in a -c file.
    withName: 'HMMSEARCH' { memory = { 2.GB * task.attempt } }
}

/*
 * Containers
 *
 * tacc-apptainer provides both `apptainer` and `singularity` on compute nodes,
 * so -profile singularity works unchanged. It does NOT work on a login node:
 * /opt/apps/tacc-apptainer/*./bin/apptainer there is a stub shell script that
 * prints "Please do not run Apptainer on the login nodes" and exits 0. Any
 * pre-staging step run from a login node therefore reports success and pulls
 * nothing. Pull from inside a batch job or an idev session.
 *
 *     module load tacc-apptainer
 *     export NXF_SINGULARITY_CACHEDIR=$WORK/blimmp/singularity_cache
 *
 * Put that cache on $WORK, not $SCRATCH. The tacc-apptainer module hard-sets
 * APPTAINER_CACHEDIR to $SCRATCH/apptainer_cache, and $SCRATCH is purged;
 * override it alongside NXF_SINGULARITY_CACHEDIR.
 */
